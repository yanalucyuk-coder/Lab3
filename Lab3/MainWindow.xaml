<Window x:Class="Lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        xmlns:local="crl-namespace:Lab3"
        mc:Ignorable="d"
        Title="Фінансові рахунки" Height="650" Width="800" Foreground="#FF252D35" Background="#A7C2FF" FontFamily="Cascadia Code">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#AB9DE3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="670*"/>
            <ColumnDefinition Width="111*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Новий рахунок" Grid.Row="0" Margin="5,5,5,5" Grid.ColumnSpan="2">
            <StackPanel Orientation="Vertical" Margin="10">

                <Label Content="Тип рахунку:"/>
                <ComboBox x:Name="AccountTypeComboBox" Width="200" HorizontalAlignment="Left" SelectionChanged="AccountTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Депозитний"/>
                    <ComboBoxItem Content="Кредитний"/>
                </ComboBox>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="DepositFields" Grid.Column="0">
                        <Label Content="Баланс:"/>
                        <Label Content="Валюта:"/>
                        <Label Content="Відсоткова ставка:"/>
                    </StackPanel>

                    <StackPanel x:Name="CreditFields" Grid.Column="0" Visibility="Collapsed">
                        <Label Content="Баланс:"/>
                        <Label Content="Валюта:"/>
                        <Label Content="Кредитний ліміт:"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBox x:Name="BalanceTextBox" Margin="0,3,0,3"/>
                        <TextBox x:Name="CurrencyTextBox" Margin="0,3,0,3"/>
                        <TextBox x:Name="InterestRateTextBox" Margin="0,3,0,3"/>
                        <TextBox x:Name="CreditLimitTextBox" Margin="0,3,0,3" Visibility="Collapsed"/>

                    </StackPanel>
                </Grid>

                <Button x:Name="CreateAccountButton" Content="Створити рахунок" Margin="0,15,0,0" HorizontalAlignment="Left" Padding="10,5" Click="CreateAccountButton_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Рахунки" Grid.Row="1" Margin="5,5,5,5" Grid.ColumnSpan="2">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="AccountsListBox" Grid.Row="0"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Label Content="Сума:"/>
                    <TextBox x:Name="AmountTextBox" Width="100" Margin="0,3,15,3"/>
                    <Label Content="Місяців:"/>
                    <TextBox x:Name="MonthsTextBox" Width="50" Margin="0,3,15,3"/>
                    <Button x:Name="DepositButton" Content="Поповнити" Margin="0,0,10,0" Padding="10,5" Click="DepositButton_Click"/>
                    <Button x:Name="WithdrawButton" Content="Зняти кошти" Margin="0,0,10,0" Padding="10,5" Click="WithdrawButton_Click"/>
                    <Button x:Name="CalculateButton" Content="Розрахувати" Margin="0,0,0,0" Padding="10,5" Click="CalculateButton_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="Аналітика" Grid.Row="2" Margin="5,5,5,5" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                <TextBlock Text="Макс. баланс: " FontWeight="Bold"/>
                <TextBlock x:Name="MaxBalanceTextBlock" Text="0.00"/>
            </StackPanel>
        </GroupBox>

    </Grid>
</Window>